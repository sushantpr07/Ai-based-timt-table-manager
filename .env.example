DATABASE_URL=postgresql+psycopg://campusflow:campusflow@localhost:5432/campusflow
POSTGRES_DB=campusflow
POSTGRES_USER=campusflow
POSTGRES_PASSWORD=replace-with-a-strong-password
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
AUTO_CREATE_SCHEMA=true
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_PREVIOUS_SECRETS=
JWT_ISSUER=campusflow-api
JWT_AUDIENCE=campusflow-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
REQUIRE_EMAIL_VERIFICATION=false
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
# Supported providers: openai or gemini. Keep this key server-side; never expose it to the browser.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
LOG_LEVEL=info
# Leave blank for local in-process limits; production Compose defaults to its private Redis service.
RATE_LIMIT_REDIS_URL=
